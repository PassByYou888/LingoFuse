%% rebar.config
%%
%% Build configuration and static-analysis configuration.
%%
%% Key points:
%%   - The pre_hook invokes c_src/build.escript to compile the NIF.
%%     On Windows, or in Erlang-only CI, set LINGOFUSE_SKIP_NIF=1
%%     to skip that step.
%%   - The plugins section enables erlfmt and hank.
%%   - The alias section provides `rebar3 check`, a one-shot
%%     static-analysis command.
%%
%% Note on linters:
%%   Elvis (rebar3_lint) is deliberately NOT used. Its configuration
%%   format changes between elvis_core releases, which makes it
%%   fragile to pin. Style checks are performed instead by a small
%%   in-script scanner in check.ps1 (see the `style` stage there).
%%
%% Typical commands (PowerShell):
%%     $env:LINGOFUSE_SKIP_NIF = "1"      # skip NIF compilation
%%     .\rebar3.cmd compile                # syntax + strict warnings
%%     .\rebar3.cmd xref                   # cross references
%%     .\rebar3.cmd dialyzer               # type analysis (slow first run)
%%     .\rebar3.cmd fmt --check            # format check
%%     .\rebar3.cmd fmt --write            # auto-format
%%     .\rebar3.cmd hank                   # dead-code detection
%%     .\rebar3.cmd check                  # everything except fmt

{erl_opts, [
    debug_info,
    warn_export_all,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warn_unused_vars,
    warn_unused_function,
    warn_bif_clash,
    warn_deprecated_function,
    warn_deprecated_type,
    warn_untyped_record
    %% Note: warn_missing_spec emits one warning per function that
    %% has no -spec. The NIF stubs in src/lingofuse_nif.erl carry no
    %% specs, so enabling it produces dozens of noise entries.
    %% Uncomment the following line if you want to enforce specs:
    %% , warn_missing_spec
]}.

{deps, []}.

{plugins, [
    rebar3_erlfmt,
    rebar3_hank
]}.

%% ---------------------------------------------------------------------------
%% NIF compilation pre-hook
%% ---------------------------------------------------------------------------
{pre_hooks, [
    {".*", compile, "escript c_src/build.escript"}
]}.

{post_hooks, [
    {".*", clean,
     "cmd /c \"if exist c_src\\*.o del /q c_src\\*.o\" 2>nul "
     "|| rm -f c_src/*.o 2>/dev/null || true"}
]}.

%% ---------------------------------------------------------------------------
%% Dialyzer: type analysis
%% ---------------------------------------------------------------------------
%% The first run builds the PLT; on Windows this takes roughly
%% 20-30 minutes. Subsequent runs are incremental and fast.
%%
%% Enabled warning categories:
%%     error_handling        - exceptions that could be avoided
%%     unmatched_returns     - return values silently discarded
%%     unknown               - functions/types that cannot be resolved
%%
%% Deliberately DISABLED:
%%     underspecs
%%         Warns when a -spec is "more permissive than the success
%%         typing", i.e. the spec declares inputs that the function
%%         cannot actually handle.
%%
%%         The public API in src/lingofuse_json.erl uses term() as the
%%         input type for dumps/1, write_json/2, and similar entry
%%         points. This mirrors the OTP built-in json module, whose
%%         encode/1 spec is also term(). Dialyzer reports five such
%%         specs as "supertype of the success typing".
%%
%%         Making the specs exact is not desirable here: the resulting
%%         union types are verbose, hard to read, and must be kept in
%%         sync with the implementation. The warnings carry no
%%         actionable information for a wrapper project like this one.
%%
%%         The other three categories remain enabled and still catch
%%         real defects (unhandled exceptions, ignored return values,
%%         unresolved calls).
%%
%%     overspecs, specdiffs
%%         Not enabled; they add noise without covering new cases.
%%
%% Note: `race_conditions` is NOT a valid Dialyzer option. It was
%% removed from the codebase long ago; concurrency issues are not
%% something Dialyzer can detect on BEAM. Use Concuerror or QuickCheck
%% for that class of analysis.
{dialyzer, [
    {warnings, [
        error_handling,
        unmatched_returns,
        unknown
    ]},
    {plt_apps, all_deps},
    {plt_extra_apps, [stdlib, kernel]},
    {exclude_mods, []}
]}.

%% ---------------------------------------------------------------------------
%% Xref: cross-reference analysis
%% ---------------------------------------------------------------------------
%% Note on `exports_not_used`:
%%   This project is a *library*. Every public function exported from
%%   src/lingofuse.erl and src/lingofuse_json.erl is intended to be
%%   called by user code outside the build tree, so Xref would flag
%%   every export as unused. That check is therefore deliberately
%%   omitted here.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%% ---------------------------------------------------------------------------
%% erlfmt: code formatting
%% ---------------------------------------------------------------------------
%% Only .erl files are handled here; .escript files are checked
%% separately by cross/check_escript.escript.
{erlfmt, [
    {print_width, 100},
    {files, ["src/*.erl", "test/*.erl"]}
]}.

%% ---------------------------------------------------------------------------
%% One-shot alias
%% ---------------------------------------------------------------------------
%% `check` deliberately omits fmt because fmt rewrites files by
%% default and CI usually wants the read-only variant.
%% Run that separately with: .\rebar3.cmd fmt --check
{alias, [
    {check, [compile, xref, hank, dialyzer]}
]}.

{shell, [
    {apps, [lingofuse]}
]}.