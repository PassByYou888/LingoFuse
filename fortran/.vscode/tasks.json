{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gfortran build",
            "type": "shell",
            "command": "gfortran",
            "args": [
                "-g",
                "-Wall",
                "-o",
                "${workspaceFolder}/${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}