<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lingofuse</groupId>
    <artifactId>lingofuse-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LingoFuse Java Binding</name>
    <description>Java binding for the LingoFuse distributed RPC framework</description>

    <properties>
        <!-- FFM API became a standard feature in JDK 22 (JEP 454). -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jackson.version>2.17.2</jackson.version>
        <junit.version>5.10.2</junit.version>

        <!--
            JDK 24+ requires explicit opt-in for native access. The
            flag is passed to both the test JVM and the exec plugin
            so that every entry point runs without the "restricted
            method" warning. Without it, the JVM still works but
            prints three warnings per test run, and a future JDK
            release will turn those into hard errors.
        -->
        <native.access.flag>--enable-native-access=ALL-UNNAMED</native.access.flag>
    </properties>

    <dependencies>
        <!--
            Jackson is the de-facto standard JSON library for Java.
            It is used by LfIo as the canonical JSON codec. Its default
            behaviour (compact output, no escaping of non-ASCII
            characters) matches the toolchain-wide serialization policy
            used by every other LingoFuse binding.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!--
                        Pass the native access flag to the test JVM.
                        This eliminates the "restricted method" warning
                        and the resulting "corrupted channel" warning
                        on every test run.
                    -->
                    <argLine>${native.access.flag}</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!--
                        Default main class for `mvn exec:java`. The
                        demo scripts below override this with
                        -Dexec.mainClass=...
                    -->
                    <mainClass>lingofuse.demo.EchoDemo</mainClass>
                    <!--
                        Pass the native access flag to the demo JVM
                        as well, so that `mvn exec:java` runs
                        warning-free.
                    -->
                    <commandlineArgs>${native.access.flag}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>