<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lingofuse</groupId>
    <artifactId>lingofuse-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LingoFuse Java Binding</name>
    <description>Java binding for the LingoFuse distributed RPC framework</description>

    <properties>
        <!-- FFM API became a standard feature in JDK 22 (JEP 454). -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jackson.version>2.17.2</jackson.version>
        <junit.version>5.10.2</junit.version>

        <!--
            JUnit Platform version. JUnit 5.10.2 corresponds to platform
            1.10.2. Both versions must be kept in lockstep with the
            JUnit Jupiter version above. See:
            https://junit.org/junit5/docs/current/user-guide/#dependency-metadata-junit-platform
        -->
        <junit.platform.version>1.10.2</junit.platform.version>

        <!--
            JDK 24+ requires explicit opt-in for native access. The
            flag is passed to both the test JVM and the exec plugin
            so that every entry point runs without the "restricted
            method" warning. Without it, the JVM still works but
            prints three warnings per test run, and a future JDK
            release will turn those into hard errors.
        -->
        <native.access.flag>--enable-native-access=ALL-UNNAMED</native.access.flag>

        <!--
            CI test mode. When true, the JUnit 5 CiTestListener emits
            one JSON line per test plus a final summary line, matching
            the format used by the C++ and C# harnesses. Enable from
            the command line:

                mvn test -Dlingofuse.ci=true

            When false or absent, the listener is a no-op and the
            test run is indistinguishable from a normal invocation.
        -->
        <lingofuse.ci>false</lingofuse.ci>
    </properties>

    <dependencies>
        <!--
            Jackson is the de-facto standard JSON library for Java.
            It is used by LfIo as the canonical JSON codec. Its default
            behaviour (compact output, no escaping of non-ASCII
            characters) matches the toolchain-wide serialization policy
            used by every other LingoFuse binding.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!--
            JUnit Jupiter: the test API, the engine, and the
            parameterised-test support. This is what the existing
            test classes (DataHandleSmokeTest, AppHandleSmokeTest)
            compile and run against.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            JUnit Platform Launcher. Required at compile time by the
            CiTestListener class, which implements
            org.junit.platform.launcher.TestExecutionListener and
            references TestPlan, TestIdentifier and
            TestExecutionResult.

            This dependency is NOT transitively pulled in by
            junit-jupiter; it must be declared explicitly. At runtime
            the JUnit Platform Launcher is already present because
            maven-surefire-plugin bundles its own copy, but the
            compiler needs the API on the compile classpath.

            Versions: platform 1.10.2 pairs with Jupiter 5.10.2.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!--
                        Pass the native access flag to the test JVM.
                        This eliminates the "restricted method" warning
                        and the resulting "corrupted channel" warning
                        on every test run.
                    -->
                    <argLine>${native.access.flag}</argLine>

                    <!--
                        Forward the CI flag to the test JVM. The
                        CiTestListener reads it via
                        System.getProperty("lingofuse.ci") to decide
                        whether to emit machine-readable JSON Lines.
                        The listener is discovered automatically
                        through the ServiceLoader entry in
                        src/test/resources/META-INF/services/.
                    -->
                    <systemPropertyVariables>
                        <lingofuse.ci>${lingofuse.ci}</lingofuse.ci>
                    </systemPropertyVariables>

                    <!--
                        Keep test stdout attached to the console so
                        the CI harness can capture the JSON Lines
                        stream from a single tee of the Maven output.
                        Redirecting to a file would hide the lines
                        from the orchestrator script.
                    -->
                    <redirectTestOutputToFile>false</redirectTestOutputToFile>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!--
                        Default main class for `mvn exec:java`. The
                        demo scripts below override this with
                        -Dexec.mainClass=...
                    -->
                    <mainClass>lingofuse.demo.EchoDemo</mainClass>
                    <!--
                        Pass the native access flag to the demo JVM
                        as well, so that `mvn exec:java` runs
                        warning-free.
                    -->
                    <commandlineArgs>${native.access.flag}</commandlineArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>