{
  "name": "lingofuse-ts",
  "version": "2.0.0",
  "description": "TypeScript binding for the LingoFuse distributed RPC framework. Runs on Node.js, Deno (2.x), and Bun.",
  "type": "commonjs",
  "keywords": [
    "lingofuse",
    "rpc",
    "ipc",
    "distributed",
    "koffi",
    "ffi",
    "typescript",
    "deno",
    "bun"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./binding": {
      "types": "./dist/binding.d.ts",
      "require": "./dist/binding.js",
      "import": "./dist/binding.js",
      "default": "./dist/binding.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "require": "./dist/errors.js",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./data-handle": {
      "types": "./dist/data-handle.d.ts",
      "require": "./dist/data-handle.js",
      "import": "./dist/data-handle.js",
      "default": "./dist/data-handle.js"
    },
    "./app-handle": {
      "types": "./dist/app-handle.d.ts",
      "require": "./dist/app-handle.js",
      "import": "./dist/app-handle.js",
      "default": "./dist/app-handle.js"
    },
    "./lf-io": {
      "types": "./dist/lf-io.d.ts",
      "require": "./dist/lf-io.js",
      "import": "./dist/lf-io.js",
      "default": "./dist/lf-io.js"
    },
    "./framework": {
      "types": "./dist/framework.d.ts",
      "require": "./dist/framework.js",
      "import": "./dist/framework.js",
      "default": "./dist/framework.js"
    },
    "./network-events": {
      "types": "./dist/network-events.d.ts",
      "require": "./dist/network-events.js",
      "import": "./dist/network-events.js",
      "default": "./dist/network-events.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "require": "./dist/status.js",
      "import": "./dist/status.js",
      "default": "./dist/status.js"
    },
    "./options": {
      "types": "./dist/options.d.ts",
      "require": "./dist/options.js",
      "import": "./dist/options.js",
      "default": "./dist/options.js"
    },
    "./address": {
      "types": "./dist/address.d.ts",
      "require": "./dist/address.js",
      "import": "./dist/address.js",
      "default": "./dist/address.js"
    },
    "./async-support": {
      "types": "./dist/async-support.d.ts",
      "require": "./dist/async-support.js",
      "import": "./dist/async-support.js",
      "default": "./dist/async-support.js"
    },
    "./p2p-registration": {
      "types": "./dist/p2p-registration.d.ts",
      "require": "./dist/p2p-registration.js",
      "import": "./dist/p2p-registration.js",
      "default": "./dist/p2p-registration.js"
    },
    "./library-loader": {
      "types": "./dist/library-loader.d.ts",
      "require": "./dist/library-loader.js",
      "import": "./dist/library-loader.js",
      "default": "./dist/library-loader.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "require": "./dist/runtime.js",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.js",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PORTABILITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",

    "test": "tsx test/test.ts",
    "test:v2": "tsx test/test-v2.ts",
    "test:all": "tsx test/test.ts && tsx test/test-v2.ts",

    "demo": "tsx examples/hello-world.ts",

    "cross:service": "tsx cross/cross-service.ts",
    "cross:node": "tsx cross/cross-node.ts",
    "cross:call": "tsx cross/cross-call.ts",

    "test:bun": "bun run test/test.ts",
    "test:v2:bun": "bun run test/test-v2.ts",
    "test:all:bun": "bun run test/test.ts && bun run test/test-v2.ts",
    "demo:bun": "bun run examples/hello-world.ts",

    "test:deno": "deno run --allow-ffi --allow-read --allow-env --allow-net --allow-sys test/test.ts",
    "test:v2:deno": "deno run --allow-ffi --allow-read --allow-env --allow-net --allow-sys --allow-run test/test-v2.ts",
    "test:all:deno": "deno run --allow-ffi --allow-read --allow-env --allow-net --allow-sys test/test.ts && deno run --allow-ffi --allow-read --allow-env --allow-net --allow-sys --allow-run test/test-v2.ts",
    "demo:deno": "deno run --allow-ffi --allow-read --allow-env --allow-net --allow-sys examples/hello-world.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}